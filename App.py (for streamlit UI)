      .stTabs [aria-selected="true"] { background:rgba(167,139,250,.13); color:#fff; }
      footer, #MainMenu { visibility:hidden; }
    </style>
    """,
    unsafe_allow_html=True,
)

# ---------------------------------------------------------------- header
st.markdown(
    """
    <div class="hero">
      <span class="pill">Scenecraft</span>
      <h1>Turn one line into a storyboard.</h1>
      <p>Describe an idea. Get a cinematic script, parsed scenes, and
         render-ready visual prompts for your AI video pipeline.</p>
    </div>
    """,
    unsafe_allow_html=True,
)

# ---------------------------------------------------------------- sidebar
with st.sidebar:
    st.markdown("### ⚙️ Generation settings")
    num_scenes = st.slider("Scenes", 3, 10, 5)
    tone = st.selectbox(
        "Tone",
        ["Cinematic", "Documentary", "Dreamlike", "Gritty noir", "Whimsical", "Epic"],
    )
    with st.expander("Advanced"):
        model = st.text_input("Model", DEFAULT_MODEL)
        temperature = st.slider("Creativity", 0.1, 1.5, 0.7, 0.1)
        max_tokens = st.slider("Max tokens", 300, 2000, 1000, 100)
    st.divider()
    st.caption("Set `HF_TOKEN` in your `.env` file to authenticate.")

# ---------------------------------------------------------------- input
left, right = st.columns([3, 1.15], gap="large")

with left:
    idea = st.text_area(
        "Your idea",
        placeholder="A lighthouse keeper who discovers the sea has stopped moving...",
        height=118,
        label_visibility="collapsed",
    )
with right:
    st.write("")
    go = st.button("✨  Generate storyboard")
    st.caption("Takes 10–30 seconds.")

if not idea:
    st.markdown("**Try one of these**")
    examples = [
        "A lighthouse keeper and a sea that stopped moving",
        "The last bookstore on Mars",
        "A courier delivering a package that hums",
    ]
    for col, ex in zip(st.columns(3), examples):
        if col.button(ex, key=ex):
            st.session_state["idea_seed"] = ex
            st.rerun()

idea = idea or st.session_state.pop("idea_seed", "")

# ---------------------------------------------------------------- run
if go or idea and st.session_state.get("auto_run"):
    st.session_state["auto_run"] = False
    if not idea.strip():
        st.warning("Enter an idea first.")
    else:
        try:
            with st.status("Working…", expanded=True) as status:
                st.write("Writing the script…")
                script = generate_script(
                    idea,
                    num_scenes=num_scenes,
                    tone=tone,
                    model=model,
                    max_tokens=max_tokens,
                    temperature=temperature,
                )
                st.write("Parsing scenes…")
                design = generate_character_design(script)
                scenes = split_into_scenes(script, style=design)
                st.write("Assembling storyboard…")
                storyboard = generate_storyboard(scenes, design)
                status.update(label="Done", state="complete", expanded=False)

            st.session_state["result"] = {
                "idea": idea,
                "script": script,
                "scenes": [s.to_dict() for s in scenes],
                "design": design,
                "storyboard": storyboard,
            }
        except MissingTokenError as e:
            st.error(str(e))
        except Exception as e:  # noqa: BLE001
            st.error(f"Generation failed: {e}")

# ---------------------------------------------------------------- output
result = st.session_state.get("result")
if result:
    st.divider()
    a, b, c = st.columns(3)
    a.metric("Scenes", len(result["scenes"]))
    b.metric("Words", len(result["script"].split()))
    c.metric("Est. runtime", f"{len(result['scenes']) * 8}s")

    tab_board, tab_script, tab_prompts, tab_json = st.tabs(
        ["🎬 Storyboard", "📄 Script", "🖼 Visual prompts", "⤓ Export"]
    )

    with tab_board:
        if not result["scenes"]:
            st.info("No scenes parsed — check the raw script tab.")
        for s in result["scenes"]:
            st.markdown(
                f"""<div class="card">
                      <div class="num">{s['scene']}</div>
                      <div class="body">{s['description']}</div>
                      <div class="prompt">{s['visual_prompt']}</div>
                    </div>""",
                unsafe_allow_html=True,
            )

    with tab_script:
        st.markdown(result["script"])

    with tab_prompts:
        for s in result["scenes"]:
            st.text_area(s["scene"], s["visual_prompt"], height=90, key=f"p_{s['scene']}")

    with tab_json:
        st.download_button(
            "Download JSON",
            json.dumps(result, indent=2),
            file_name="storyboard.json",
            mime="application/json",
        )
        st.download_button(
            "Download storyboard (.txt)",
            result["storyboard"],
            file_name="storyboard.txt",
        )
        st.json(result)
