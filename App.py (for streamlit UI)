import json
import streamlit as st
from dotenv import load_dotenv

from pipeline import (
    DEFAULT_MODEL,
    MissingTokenError,
    generate_character_design,
    generate_script,
    generate_storyboard,
    split_into_scenes,
)

load_dotenv()

st.set_page_config(
    page_title="Scenecraft — AI Storyboard Studio",
    page_icon="🎬",
    layout="wide",
    initial_sidebar_state="expanded",
)

# ---------------------------------------------------------------- styling
st.markdown(
    """
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=Inter:wght@400;500&display=swap');

